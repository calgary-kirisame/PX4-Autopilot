#!/bin/sh
#
# @name Gazebo x500 external vision (ground-truth EV)
#
# @type Quadrotor
#

PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500}

. ${R}etc/init.d-posix/airframes/4001_gz_x500

# Ground-truth EV stands in for the mocap/QTM link, which gives pose only. Fuse EV
# horizontal+vertical position and yaw (EKF2_EV_CTRL=11 = bits 0+1+3); do NOT fuse
# EV velocity -- a mocap rig has no velocity output, so EKF2 derives it from the IMU.
# Make vision the height reference (EKF2_HGT_REF=3); demote GNSS to velocity-only
# (EKF2_GPS_CTRL=4) so vision holds position/height/heading authority. EKF2_EV_DELAY
# is provisional until measured open-loop against vehicle_local_position.
param set-default EKF2_EV_CTRL 11
param set-default EKF2_HGT_REF 3
param set-default EKF2_GPS_CTRL 4
param set-default EKF2_EV_DELAY 5

# Companion/offboard operation does not require RC or GCS while OFFBOARD is
# the intended mode; offboard setpoint loss remains handled separately.
param set-default COM_DLL_EXCEPT 4
param set-default COM_RCL_EXCEPT 4

# No MAVLink GCS in this XRCE-DDS-only setup, so disable the GCS-link-loss
# failsafe action. COM_DLL_EXCEPT only excepts OFFBOARD; without this the
# failsafe fires (action RTL) the moment we hand off OFFBOARD -> AUTO.RTL.
param set-default NAV_DLL_ACT 0
