#!/bin/sh
#
# @name Gazebo x500 external vision (ground-truth EV)
#
# @type Quadrotor
#

PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500}

. ${R}etc/init.d-posix/airframes/4001_gz_x500

# Ground-truth EV stands in for the mocap/QTM link. Fuse EV horizontal+vertical
# position, 3D velocity, and yaw (EKF2_EV_CTRL=15); make vision the height
# reference (EKF2_HGT_REF=3); demote GNSS to velocity-only (EKF2_GPS_CTRL=4) so
# vision holds position/height/heading authority. EKF2_EV_DELAY is provisional
# until measured open-loop against vehicle_local_position.
param set-default EKF2_EV_CTRL 15
param set-default EKF2_HGT_REF 3
param set-default EKF2_GPS_CTRL 4
param set-default EKF2_EV_DELAY 5
